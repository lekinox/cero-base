{
  "name": "@cero-base/cero",
  "version": "2.0.0",
  "description": "The ideal p2p API — everything is a handle, handles contain refs, refs contain rows.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lekinox/cero-base.git",
    "directory": "packages/cero"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE",
    "!**/CLAUDE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./build": {
      "types": "./types/build/index.d.ts",
      "default": "./src/build/index.js"
    },
    "./server": {
      "types": "./types/rpc/server.d.ts",
      "default": "./src/rpc/server.js"
    },
    "./client": {
      "types": "./types/rpc/client.d.ts",
      "default": "./src/rpc/client.js"
    },
    "./extensions": {
      "types": "./types/extensions/index.d.ts",
      "default": "./src/extensions/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "build": [
        "types/build/index.d.ts"
      ],
      "server": [
        "types/rpc/server.d.ts"
      ],
      "client": [
        "types/rpc/client.d.ts"
      ],
      "extensions": [
        "types/extensions/index.d.ts"
      ]
    }
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "crypto": {
      "bare": "bare-crypto",
      "default": "crypto"
    },
    "url": {
      "bare": "bare-url",
      "default": "url"
    },
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    }
  },
  "scripts": {
    "build:test": "rm -rf test/fixtures/spec && node test/fixtures/build.js",
    "build:types": "rm -rf types && tsc -p .",
    "pretest": "npm run build:test",
    "prepublishOnly": "npm run build:types",
    "test": "npm run test:bare",
    "pretest:bare": "npm run build:test",
    "test:bare": "find test -name '*.test.js' | sort | xargs -P1 -n1 brittle-bare",
    "test:node": "find test -name '*.test.js' | sort | xargs -P1 -n1 brittle-node"
  },
  "dependencies": {
    "@cero-base/core": "^2.0.0",
    "b4a": "^1.8.1",
    "bare-abort-controller": "^1.1.2",
    "bare-crypto": "^1.15.3",
    "bare-fs": "^4.8.1",
    "bare-path": "^3.1.2",
    "ble-swarm": "^2.3.0",
    "compact-encoding": "^3.4.0",
    "corestore": "^7.12.3",
    "hrpc": "^4.3.1",
    "hypercore": "^11.35.4",
    "hypercore-crypto": "^3.7.0",
    "hypercore-id-encoding": "^1.3.0",
    "hypercore-storage": "^3.2.1",
    "hyperdb": "^6.9.0",
    "hyperdispatch": "^1.6.0",
    "hyperschema": "^1.23.0",
    "ready-resource": "^1.2.0",
    "safety-catch": "^1.0.3",
    "streamx": "^2.28.1",
    "suspendify": "^1.7.2",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@hyperswarm/testnet": "^3.1.4",
    "bare-events": "^2.9.2",
    "bare-fetch": "^3.2.1",
    "bare-process": "^4.5.1",
    "bare-url": "^2.5.4",
    "brittle": "^4.1.1",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0"
}
