{
  "name": "chat-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared cero schema + Chat helper for the chat examples",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./schema": "./schema.js",
    "./spec": "./spec/index.js",
    "./client": "./client.js",
    "./server": "./server.js"
  },
  "imports": {
