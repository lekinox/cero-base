{
  "name": "chat-mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React Native / Expo chat reference app using cero",
  "main": "index.js",
  "scripts": {
    "build": "bare-pack worklets/main.js --host ios-arm64-simulator --linked --defer debug -o worklets/app.bundle.mjs",
    "build:device": "bare-pack worklets/main.js --host ios-arm64 --linked --defer debug -o worklets/app.bundle.mjs",
    "start": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start -d",
    "link": "bare-link . --host ios-arm64 --host ios-arm64-simulator --host ios-x64-simulator --out ../../node_modules/react-native-bare-kit/ios/addons",
    "ios": "npm run link && expo run:ios",
    "android": "expo run:android"
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    }
  },
  "dependencies": {
    "@cero-base/cero": "*",
    "bare-fs": "^4.8.4",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.2",
    "chat-backend": "*",
    "expo": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-bare-kit": "^0.16.0"
  },
  "devDependencies": {
    "bare-pack": "^3.0.2"
  }
}
